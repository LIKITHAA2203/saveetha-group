{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "procurement", "manager"] }
      },
      "required": ["uid", "email"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "Supplier information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "contactPerson": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "rating": { "type": "number" },
        "trustScore": { "type": "number" },
        "qualityScore": { "type": "number" },
        "responseSpeed": { "type": "number" }
      },
      "required": ["name", "email"]
    },
    "RFQ": {
      "title": "RFQ",
      "description": "Request for Quotation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "requiredDate": { "type": "string", "format": "date-time" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "status": { "type": "string", "enum": ["open", "closed", "awarded"] },
        "assignedVendors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemName", "quantity", "status"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Vendor quotation for an RFQ",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rfqId": { "type": "string" },
        "vendorId": { "type": "string" },
        "vendorName": { "type": "string" },
        "itemName": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "deliveryDays": { "type": "number" },
        "tax": { "type": "number" },
        "warranty": { "type": "string" },
        "paymentTerms": { "type": "string" },
        "extractedAt": { "type": "string", "format": "date-time" },
        "riskScore": { "type": "number" },
        "recommendationScore": { "type": "number" }
      },
      "required": ["rfqId", "vendorId", "price"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Finalized purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quoteId": { "type": "string" },
        "vendorId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "shipped", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "financeStatus": { "type": "string", "enum": ["unpaid", "partially_paid", "paid"] }
      },
      "required": ["quoteId", "vendorId", "totalAmount", "status"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Stock item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currentStock": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "dailyUsage": { "type": "number" },
        "leadTime": { "type": "number" }
      },
      "required": ["name", "currentStock"]
    }
  },
  "firestore": {
    "/users/{uid}": { "schema": "User", "description": "User profiles" },
    "/vendors/{vendorId}": { "schema": "Vendor", "description": "Vendor database" },
    "/rfqs/{rfqId}": { "schema": "RFQ", "description": "Requests for Quotation" },
    "/quotes/{quoteId}": { "schema": "Quote", "description": "Vendor quotes" },
    "/purchaseOrders/{poId}": { "schema": "PurchaseOrder", "description": "Purchase orders" },
    "/inventory/{itemId}": { "schema": "InventoryItem", "description": "Inventory tracking" }
  }
}
